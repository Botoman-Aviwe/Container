@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<style>
    /* Container */
    .register-container {
        min-height: 100vh;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    /* Card */
    .register-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        max-width: 600px;
        width: 100%;
        border: 2px solid #d32f2f;
    }

    /* Header */
    .register-header {
        background: #d32f2f;
        color: white;
        padding: 40px 30px 30px;
        text-align: center;
    }

        .register-header img {
            max-width: 120px;
            margin-bottom: 15px;
        }

    .welcome-text {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    /* Body */
    .register-body {
        padding: 40px 30px;
    }

    .form-floating {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 1rem 1rem;
        border: 2px solid #e2e8f0;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #d32f2f;
            box-shadow: 0 0 0 3px rgba(211, 47, 47, 0.1);
        }

    .btn-register {
        background: #d32f2f;
        border: none;
        border-radius: 12px;
        padding: 15px 30px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: 10px;
    }

        .btn-register:hover {
            background: #b71c1c;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(211, 47, 47, 0.3);
        }

    .login-link {
        text-align: center;
        margin-top: 25px;
        color: #64748b;
    }

        .login-link a {
            color: #d32f2f;
            font-weight: 600;
            text-decoration: none;
        }

            .login-link a:hover {
                text-decoration: underline;
            }

    .name-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 576px) {
        .name-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="register-container">
    <div class="register-card">

        <!-- Header -->
        <div class="register-header">
            <img src="~/images/unnamed.jpg" alt="Transnet Logo" />
            <div class="welcome-text">Create Account</div>
            <div class="subtitle">Register to access your dashboard</div>
        </div>

        <!-- Form -->
        <div class="register-body">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Name Row -->
                <div class="name-row">
                    <div class="form-floating">
                        <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
                        <label asp-for="Input.FirstName">First Name</label>
                        <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating">
                        <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
                        <label asp-for="Input.LastName">Last Name</label>
                        <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Email -->
                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email Address</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <!-- Identity Number -->
                <div class="form-floating">
                    <input asp-for="Input.IdentityNumber" class="form-control" placeholder="Identity Number" />
                    <label asp-for="Input.IdentityNumber">Identity Number</label>
                    <span asp-validation-for="Input.IdentityNumber" class="text-danger small"></span>
                </div>

                <!-- SAP Number -->
                <div class="form-floating">
                    <input asp-for="Input.HealthCouncilRegistrationNumber" class="form-control" placeholder="SAP Number" />
                    <label asp-for="Input.HealthCouncilRegistrationNumber">SAP Number</label>
                    <span asp-validation-for="Input.HealthCouncilRegistrationNumber" class="text-danger small"></span>
                </div>

                <!-- Role -->
                <div class="form-floating">
                    <select asp-for="Input.Role" asp-items="Model.Input.RoleList" class="form-select">
                        <option disabled selected>Select your role</option>
                    </select>
                    <label asp-for="Input.Role">Professional Role</label>
                    <span asp-validation-for="Input.Role" class="text-danger small"></span>
                </div>

                <!-- Button -->
                <button type="submit" class="w-100 btn btn-register text-white">
                    <i class="fas fa-user-plus me-2"></i>Create Account
                </button>

                <div class="login-link">
                    Already have an account?
                    <a href="/Identity/Account/Login">Sign In</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}