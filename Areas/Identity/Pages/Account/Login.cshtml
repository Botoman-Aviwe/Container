@page
@model LoginModel
@{
    ViewData["Title"] = "Welcome Back";
}

<style>
    /* Container */
    .login-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #ffffff 0%, #ffffff 100%); /* White background */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    /* Card */
    .login-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        max-width: 450px;
        width: 100%;
        border: 2px solid #d32f2f; /* Red border */
    }

    /* Header */
    .login-header {
        background: #d32f2f; /* Transnet red */
        color: white;
        padding: 40px 30px 30px;
        text-align: center;
        position: relative;
    }

        .login-header img {
            max-width: 120px;
            margin-bottom: 15px;
        }

    .welcome-text {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    /* Body */
    .login-body {
        padding: 40px 30px;
    }

    .form-floating {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-control {
        border-radius: 12px;
        padding: 1rem 1rem;
        border: 2px solid #e2e8f0;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

        .form-control:focus {
            border-color: #d32f2f; /* red focus */
            box-shadow: 0 0 0 3px rgba(211, 47, 47, 0.1);
        }

    .form-label {
        color: #64748b;
        font-weight: 500;
    }

    /* Button */
    .btn-login {
        background: #d32f2f;
        border: none;
        border-radius: 12px;
        padding: 15px 30px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: 10px;
    }

        .btn-login:hover {
            background: #b71c1c;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(211, 47, 47, 0.3);
        }

    .form-check-input:checked {
        background-color: #d32f2f;
        border-color: #d32f2f;
    }

    .form-check-label {
        color: #64748b;
        font-weight: 500;
    }

    /* Links */
    .links-section {
        text-align: center;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

        .links-section a {
            color: #d32f2f;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            .links-section a:hover {
                color: #b71c1c;
                text-decoration: underline;
            }

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        z-index: 5;
    }

    .form-floating .form-control {
        padding-left: 45px;
    }

    .form-floating > label {
        left: 45px;
    }

    .password-toggle {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #64748b;
        cursor: pointer;
        z-index: 5;
    }

    .feature-badge {
        background: rgba(211, 47, 47, 0.1);
        color: #d32f2f;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
        display: inline-block;
        margin: 5px;
    }

    .login-footer {
        text-align: center;
        margin-top: 30px;
        color: #64748b;
    }

        .login-footer a {
            color: #d32f2f;
            font-weight: 600;
            text-decoration: none;
        }

            .login-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="login-container">
    <div class="login-card">
        <!-- Header Section -->
        <div class="login-header">
            <img src="~/images/unnamed.jpg" alt="Transnet Logo" />
            <div class="welcome-text">Welcome Back</div>
            <div class="subtitle">Sign in to your account</div>

            <div class="mt-3">
                <span class="feature-badge">
                    <i class="fas fa-shield-alt me-1"></i>Secure Login
                </span>
                <span class="feature-badge">
                    <i class="fas fa-bolt me-1"></i>Fast Access
                </span>
            </div>
        </div>

        <!-- Login Form -->
        <div class="login-body">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- Email Field -->
                <div class="form-floating">
                    <i class="fas fa-envelope input-icon"></i>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username"
                           aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email address</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <!-- Password Field -->
                <div class="form-floating">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                           aria-required="true" placeholder="Password" id="password" />
                    <label asp-for="Input.Password">Password</label>
                    <button type="button" class="password-toggle" id="togglePassword">
                        <i class="fas fa-eye"></i>
                    </button>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">
                            Remember me
                        </label>
                    </div>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none">
                        Forgot password?
                    </a>
                </div>

                <!-- Login Button -->
                <button id="login-submit" type="submit" class="w-100 btn btn-login text-white">
                    <i class="fas fa-sign-in-alt me-2"></i>Sign In
                </button>

                <!-- Links Section -->
                <div class="links-section">
                    <div class="mb-2">
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">
                            Resend email confirmation
                        </a>
                    </div>
                    <div>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                            Create new account
                        </a>
                    </div>
                </div>
            </form>

            <!-- Footer -->
            <div class="login-footer">
                <small>Secure access to your professional dashboard</small>
            </div>
        </div>
    </div>
</div>