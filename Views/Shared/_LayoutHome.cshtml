@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Transnet Container Operations MIS
    </title>


    <!-- =========================================================
         BOOTSTRAP
         ========================================================= -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- =========================================================
         BOOTSTRAP ICONS
         ========================================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- =========================================================
         OWL CAROUSEL
         ========================================================= -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">


    <!-- =========================================================
         SITE CSS
         ========================================================= -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site - Copy.css"
          asp-append-version="true" />


    <!-- =========================================================
         APPLICATION STYLES
         ========================================================= -->

    <link rel="stylesheet"
          href="~/PrescribingSystem.styles.css"
          asp-append-version="true" />


    <!-- PAGE SPECIFIC CSS -->
    @RenderSection("Styles", required: false)


    <!-- =========================================================
         CONTAINER MIS GLOBAL STYLE
         ========================================================= -->

    <style>

        :root {
            --transnet-blue: #003b71;
            --transnet-dark-blue: #00264d;
            --transnet-light-blue: #eaf3fb;
            --transnet-yellow: #f5c400;
            --terminal-grey: #f4f6f8;
            --terminal-dark: #1f2937;
        }


        /* =====================================================
                   BODY
                   ===================================================== */

        body {
            background: #f5f7fa;
            padding-top: 76px;
            color: #212529;
        }


        /* =====================================================
                   NAVBAR
                   ===================================================== */

        .navbar {
            background: linear-gradient( 90deg, var(--transnet-dark-blue), var(--transnet-blue) ) !important;
            box-shadow: 0 3px 12px rgba(0,0,0,.18);
            min-height: 76px;
        }


        .navbar-brand {
            display: flex;
            align-items: center;
            font-weight: 700;
            letter-spacing: .3px;
        }


        .navbar-logo {
            height: 48px;
            width: auto;
            object-fit: contain;
            background: white;
            padding: 4px 8px;
            border-radius: 6px;
        }


        .brand-title {
            color: white;
            font-weight: 700;
            margin-left: 12px;
            line-height: 1.1;
        }


        .brand-subtitle {
            display: block;
            font-size: .72rem;
            font-weight: 400;
            opacity: .75;
            margin-top: 3px;
        }


        /* =====================================================
                   NAVIGATION
                   ===================================================== */

        .navbar-nav .nav-link {
            color: rgba(255,255,255,.88) !important;
            padding: .65rem .85rem !important;
            border-radius: 7px;
            margin: 0 2px;
            transition: all .2s ease;
        }


            .navbar-nav .nav-link:hover {
                background: rgba(255,255,255,.12);
                color: white !important;
            }


            .navbar-nav .nav-link.active {
                background: rgba(245,196,0,.18);
                color: #fff !important;
                border-bottom: 2px solid var(--transnet-yellow);
            }


            .navbar-nav .nav-link i {
                margin-right: 5px;
            }


        /* =====================================================
                   SYSTEM STATUS
                   ===================================================== */

        .system-status {
            display: flex;
            align-items: center;
            color: white;
            font-size: .8rem;
            margin-right: 15px;
        }


        .status-dot {
            width: 9px;
            height: 9px;
            background: #28a745;
            border-radius: 50%;
            margin-right: 6px;
            box-shadow: 0 0 8px rgba(40,167,69,.8);
        }


        /* =====================================================
                   HERO
                   ===================================================== */

        .hero-section {
            background: linear-gradient( rgba(0,38,77,.88), rgba(0,59,113,.88) ), url('/images/welcome.webp');
            background-size: cover;
            background-position: center;
            min-height: 470px;
            display: flex;
            align-items: center;
            color: white;
            position: relative;
        }


        .hero-title {
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 800;
            line-height: 1.1;
        }


        .hero-subtitle {
            font-size: 1.05rem;
            line-height: 1.7;
            max-width: 650px;
            opacity: .9;
        }


        .hero-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(245,196,0,.15);
            border: 1px solid rgba(245,196,0,.45);
            color: white;
            padding: 7px 13px;
            border-radius: 30px;
            margin-bottom: 18px;
            font-size: .85rem;
        }


            .hero-badge i {
                color: var(--transnet-yellow);
                margin-right: 7px;
            }


        .hero-image {
            max-height: 360px;
            width: 100%;
            object-fit: cover;
            box-shadow: 0 15px 40px rgba(0,0,0,.3);
        }


        /* =====================================================
                   SECTION TITLES
                   ===================================================== */

        .section-title {
            font-weight: 800;
            color: var(--transnet-dark-blue);
        }


        .section-subtitle {
            color: #6c757d;
            max-width: 700px;
            margin: auto;
        }


        /* =====================================================
                   KPI CARDS
                   ===================================================== */

        .kpi-card {
            background: white;
            border: 0;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,.07);
            transition: all .2s ease;
            height: 100%;
        }


            .kpi-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(0,0,0,.12);
            }


        .kpi-icon {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }


        .kpi-number {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--transnet-dark-blue);
        }


        .kpi-label {
            font-size: .8rem;
            color: #6c757d;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .4px;
        }


        /* =====================================================
                   OPERATIONS CARDS
                   ===================================================== */

        .operation-card {
            background: white;
            border: 0;
            border-radius: 15px;
            padding: 28px;
            height: 100%;
            box-shadow: 0 4px 15px rgba(0,0,0,.06);
            transition: all .25s ease;
        }


            .operation-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 28px rgba(0,0,0,.12);
            }


        .operation-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            margin-bottom: 18px;
        }


        .operation-card h4 {
            font-weight: 700;
            color: var(--transnet-dark-blue);
        }


        .operation-card p {
            color: #6c757d;
            line-height: 1.6;
        }


        /* =====================================================
                   TABLE
                   ===================================================== */

        .table thead {
            background: var(--transnet-dark-blue);
            color: white;
        }


            .table thead th {
                border: 0;
                font-size: .85rem;
                font-weight: 600;
            }


        .table tbody tr:hover {
            background-color: var(--transnet-light-blue);
        }


        /* =====================================================
                   BUTTONS
                   ===================================================== */

        .btn-transnet {
            background: var(--transnet-blue);
            border-color: var(--transnet-blue);
            color: white;
        }


            .btn-transnet:hover {
                background: var(--transnet-dark-blue);
                border-color: var(--transnet-dark-blue);
                color: white;
            }


        .btn-terminal {
            background: var(--transnet-yellow);
            border-color: var(--transnet-yellow);
            color: #212529;
            font-weight: 600;
        }


            .btn-terminal:hover {
                filter: brightness(.93);
            }


        /* =====================================================
                   ALERT / STATUS BADGES
                   ===================================================== */

        .container-status {
            padding: 6px 11px;
            border-radius: 20px;
            font-size: .75rem;
            font-weight: 600;
        }


        /* =====================================================
                   FOOTER
                   ===================================================== */

        .footer {
            background: var(--transnet-dark-blue);
            color: white;
            padding: 55px 0 25px;
            margin-top: 70px;
        }


        .footer-brand {
            color: white;
        }


        .footer-logo {
            height: 48px;
            width: auto;
            background: white;
            padding: 5px;
            border-radius: 6px;
        }


        .footer-text {
            color: rgba(255,255,255,.7);
            line-height: 1.7;
        }


        .footer-heading {
            color: white;
            font-weight: 700;
        }


        .footer-links a {
            color: rgba(255,255,255,.7);
            text-decoration: none;
            transition: .2s;
        }


            .footer-links a:hover {
                color: var(--transnet-yellow);
            }


        .footer-contact {
            color: rgba(255,255,255,.7);
        }


            .footer-contact i {
                color: var(--transnet-yellow);
            }


        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,.12);
            padding-top: 20px;
            margin-top: 35px;
        }


        /* =====================================================
                   RESPONSIVE
                   ===================================================== */

        @@media (max-width: 991px) {

            .navbar-nav {
                padding-top: 15px;
                padding-bottom: 15px;
            }

            .system-status {
                display: none;
            }

            .brand-title {
                font-size: .9rem;
            }
        }


        @@media (max-width: 576px) {

            body {
                padding-top: 70px;
            }

            .navbar-logo {
                height: 40px;
            }

            .hero-section {
                min-height: 550px;
            }

            .hero-title {
                font-size: 2rem;
            }
        }

    </style>

</head>


<body>


    <!-- ============================================================
         NAVIGATION
         ============================================================ -->

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">

        <div class="container-fluid px-4">


            <!-- BRAND -->

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/unnamed.jpg"
                     alt="Transnet"
                     class="navbar-logo" />

                <span class="brand-title">

                    Container Terminal MIS

                    <span class="brand-subtitle">
                        Terminal Operations & Information Management
                    </span>

                </span>

            </a>


            <!-- MOBILE BUTTON -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- NAVIGATION -->

            <div class="collapse navbar-collapse"
                 id="navbarNav">


                <ul class="navbar-nav ms-auto align-items-lg-center">


                    <!-- SYSTEM STATUS -->

                    <li class="nav-item d-none d-lg-block">

                        <div class="system-status">

                            <span class="status-dot"></span>

                            System Online

                        </div>

                    </li>


                    <!-- DASHBOARD -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-speedometer2"></i>

                            Dashboard

                        </a>

                    </li>


                    <!-- CONTAINERS -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Cargo"
                           asp-action="CargoView">

                            <i class="bi bi-box-seam"></i>

                            Containers

                        </a>

                    </li>


                    <!-- MOVEMENTS -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Cargo"
                           asp-action="MovedContainers">

                            <i class="bi bi-arrow-left-right"></i>

                            Movements

                        </a>

                    </li>


                    <!-- OPERATIONS -->

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            <i class="bi bi-activity"></i>

                            Operations

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow">


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="TruckTurnaround"
                                   asp-action="Index">

                                    <i class="bi bi-truck me-2"></i>

                                    Truck Turnaround

                                </a>

                            </li>


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="VesselOperation"
                                   asp-action="Index">

                                    <i class="bi bi-water me-2"></i>

                                    Vessel Operations

                                </a>

                            </li>


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Operations"
                                   asp-action="OperationsReport">

                                    <i class="bi bi-bar-chart-line me-2"></i>

                                    Operations Report

                                </a>

                            </li>


                        </ul>

                    </li>


                    <!-- REPORTS -->

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            <i class="bi bi-file-earmark-bar-graph"></i>

                            Reports

                        </a>


                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Reports"
                                   asp-action="Index">

                                    <i class="bi bi-graph-up me-2"></i>

                                    MIS Reports

                                </a>

                            </li>


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Operations"
                                   asp-action="OperationsReport">

                                    <i class="bi bi-clipboard-data me-2"></i>

                                    Operations Report

                                </a>

                            </li>


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Cargo"
                                   asp-action="MovedContainers">

                                    <i class="bi bi-arrow-repeat me-2"></i>

                                    Container Movements

                                </a>

                            </li>

                        </ul>

                    </li>


                </ul>


                <!-- LOGIN -->

                <div class="ms-lg-3">

                    <partial name="_LoginPartial" />

                </div>


            </div>

        </div>

    </nav>


    <!-- ============================================================
         HOME PAGE HERO
         ============================================================ -->
    @if (ViewContext.RouteData.Values["Action"]?.ToString() == "Index")
    {

        <section class="hero-section">


            <div class="container">

                <div class="row align-items-center g-5">


                    <div class="col-lg-7">


                        <div class="hero-badge">

                            <i class="bi bi-shield-check"></i>

                            Terminal Operations Management System

                        </div>


                        <h1 class="hero-title">

                            Container Terminal
                            Management Information System

                        </h1>


                        <p class="hero-subtitle mt-4">

                            Centralised operational information for monitoring
                            container movements, terminal activities, truck
                            turnaround times and operational performance.

                        </p>


                        <div class="mt-4">

                            <a asp-controller="Cargo"
                               asp-action="CargoView"
                               class="btn btn-terminal btn-lg me-2 mb-2">

                                <i class="bi bi-box-seam me-2"></i>

                                Container Operations

                            </a>


                            <a asp-controller="Cargo"
                               asp-action="MovedContainers"
                               class="btn btn-outline-light btn-lg mb-2">

                                <i class="bi bi-arrow-left-right me-2"></i>

                                View Movements

                            </a>

                        </div>


                    </div>


                    <div class="col-lg-5">

                        <img src="~/images/welcome.webp"
                             alt="Container Terminal Operations"
                             class="img-fluid rounded-4 hero-image" />

                    </div>


                </div>

            </div>

        </section>


        <!-- ============================================================
             KPI SECTION
             ============================================================ -->

        <section class="py-5">

            <div class="container">


                <div class="text-center mb-5">

                    <h2 class="section-title">

                        Terminal Operations Overview

                    </h2>

                    <p class="section-subtitle mt-2">

                        Key operational areas monitored through the
                        Management Information System.

                    </p>

                </div>


                <div class="row g-4">


                    <!-- CONTAINERS -->

                    <div class="col-md-6 col-lg-3">

                        <div class="kpi-card p-4">

                            <div class="d-flex align-items-center">

                                <div class="kpi-icon bg-primary bg-opacity-10 text-primary me-3">

                                    <i class="bi bi-box-seam"></i>

                                </div>

                                <div>

                                    <div class="kpi-label">
                                        Containers
                                    </div>

                                    <div class="kpi-number">
                                        -
                                    </div>

                                </div>

                            </div>

                            <div class="small text-muted mt-3">

                                Container movements and tracking

                            </div>

                        </div>

                    </div>


                    <!-- TRUCKS -->

                    <div class="col-md-6 col-lg-3">

                        <div class="kpi-card p-4">

                            <div class="d-flex align-items-center">

                                <div class="kpi-icon bg-success bg-opacity-10 text-success me-3">

                                    <i class="bi bi-truck"></i>

                                </div>

                                <div>

                                    <div class="kpi-label">
                                        Trucks
                                    </div>

                                    <div class="kpi-number">
                                        -
                                    </div>

                                </div>

                            </div>

                            <div class="small text-muted mt-3">

                                Gate and truck turnaround monitoring

                            </div>

                        </div>

                    </div>


                    <!-- VESSELS -->

                    <div class="col-md-6 col-lg-3">

                        <div class="kpi-card p-4">

                            <div class="d-flex align-items-center">

                                <div class="kpi-icon bg-info bg-opacity-10 text-info me-3">

                                    <i class="bi bi-water"></i>

                                </div>

                                <div>

                                    <div class="kpi-label">
                                        Vessel Operations
                                    </div>

                                    <div class="kpi-number">
                                        -
                                    </div>

                                </div>

                            </div>

                            <div class="small text-muted mt-3">

                                Vessel productivity and performance

                            </div>

                        </div>

                    </div>


                    <!-- REPORTS -->

                    <div class="col-md-6 col-lg-3">

                        <div class="kpi-card p-4">

                            <div class="d-flex align-items-center">

                                <div class="kpi-icon bg-warning bg-opacity-10 text-warning me-3">

                                    <i class="bi bi-bar-chart-line"></i>

                                </div>

                                <div>

                                    <div class="kpi-label">
                                        MIS Reporting
                                    </div>

                                    <div class="kpi-number">
                                        -
                                    </div>

                                </div>

                            </div>

                            <div class="small text-muted mt-3">

                                Operational reporting and analytics

                            </div>

                        </div>

                    </div>


                </div>

            </div>

        </section>


        <!-- ============================================================
             OPERATIONS SECTION
             ============================================================ -->

        <section class="py-5 bg-light">

            <div class="container">


                <div class="text-center mb-5">

                    <h2 class="section-title">

                        Terminal Operations

                    </h2>

                    <p class="section-subtitle mt-2">

                        Access the operational modules used to manage
                        terminal activities.

                    </p>

                </div>


                <div class="row g-4">


                    <!-- CONTAINER MANAGEMENT -->

                    <div class="col-md-6 col-lg-4">

                        <div class="operation-card">

                            <div class="operation-icon bg-primary bg-opacity-10 text-primary">

                                <i class="bi bi-box-seam"></i>

                            </div>

                            <h4>
                                Container Management
                            </h4>

                            <p>

                                Manage container loading, movement and
                                receiving activities across terminal
                                locations.

                            </p>

                            <a asp-controller="Cargo"
                               asp-action="CargoView"
                               class="btn btn-transnet">

                                Open Containers

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- MOVEMENTS -->

                    <div class="col-md-6 col-lg-4">

                        <div class="operation-card">

                            <div class="operation-icon bg-success bg-opacity-10 text-success">

                                <i class="bi bi-arrow-left-right"></i>

                            </div>

                            <h4>
                                Container Movements
                            </h4>

                            <p>

                                Track containers moved between terminal
                                locations and record receiving times.

                            </p>

                            <a asp-controller="Cargo"
                               asp-action="MovedContainers"
                               class="btn btn-success">

                                View Movements

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- TRUCK OPERATIONS -->

                    <div class="col-md-6 col-lg-4">

                        <div class="operation-card">

                            <div class="operation-icon bg-warning bg-opacity-10 text-warning">

                                <i class="bi bi-truck"></i>

                            </div>

                            <h4>
                                Truck Operations
                            </h4>

                            <p>

                                Monitor truck movements, terminal visits
                                and Truck Turnaround Time performance.

                            </p>

                            <a asp-controller="TruckTurnaround"
                               asp-action="Index"
                               class="btn btn-warning">

                                Truck Operations

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- VESSEL OPERATIONS -->

                    <div class="col-md-6 col-lg-4">

                        <div class="operation-card">

                            <div class="operation-icon bg-info bg-opacity-10 text-info">

                                <i class="bi bi-water"></i>

                            </div>

                            <h4>
                                Vessel Operations
                            </h4>

                            <p>

                                Monitor vessel operations, productivity,
                                delays, tonnage and operational performance.

                            </p>

                            <a asp-controller="VesselOperation"
                               asp-action="Index"
                               class="btn btn-info text-white">

                                Vessel Operations

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- MIS REPORTING -->

                    <div class="col-md-6 col-lg-4">

                        <div class="operation-card">

                            <div class="operation-icon bg-danger bg-opacity-10 text-danger">

                                <i class="bi bi-bar-chart-line"></i>

                            </div>

                            <h4>
                                MIS Reporting
                            </h4>

                            <p>

                                Generate operational reports and analyse
                                terminal performance using key operational
                                indicators.

                            </p>

                            <a asp-controller="Operations"
                               asp-action="OperationsReport"
                               class="btn btn-danger">

                                View Reports

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                    <!-- DATA ANALYTICS -->

                    <div class="col-md-6 col-lg-4">

                        <div class="operation-card">

                            <div class="operation-icon bg-secondary bg-opacity-10 text-secondary">

                                <i class="bi bi-graph-up-arrow"></i>

                            </div>

                            <h4>
                                Data Analytics
                            </h4>

                            <p>

                                Use operational data to identify trends,
                                bottlenecks and opportunities for improved
                                terminal performance.

                            </p>

                            <a asp-controller="Reports"
                               asp-action="Index"
                               class="btn btn-secondary">

                                Analytics

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>


                </div>

            </div>

        </section>


        <!-- ============================================================
             SYSTEM INFORMATION
             ============================================================ -->

        <section class="py-5">

            <div class="container">


                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4 p-lg-5">

                        <div class="row align-items-center">


                            <div class="col-lg-8">

                                <span class="badge bg-primary mb-3">

                                    <i class="bi bi-info-circle me-1"></i>

                                    Terminal MIS

                                </span>


                                <h3 class="fw-bold">

                                    Centralised Operational Information

                                </h3>


                                <p class="text-muted mb-0">

                                    The system provides a central platform
                                    for capturing, monitoring and reporting
                                    operational information across terminal
                                    activities. This supports accurate
                                    decision-making and improved visibility
                                    of operational performance.

                                </p>

                            </div>


                            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">

                                <a asp-controller="Operations"
                                   asp-action="OperationsReport"
                                   class="btn btn-transnet btn-lg">

                                    <i class="bi bi-file-earmark-bar-graph me-2"></i>

                                    View Operations Report

                                </a>

                            </div>


                        </div>

                    </div>

                </div>

            </div>

        </section>

    }


    <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- ============================================================
         FOOTER
         ============================================================ -->

    <footer class="footer">


        <div class="container">


            <div class="row g-5">


                <!-- ABOUT -->

                <div class="col-lg-4 col-md-6">

                    <div class="footer-brand">

                        <img src="~/images/unnamed.jpg"
                             alt="Transnet"
                             class="footer-logo mb-3">


                        <h5 class="fw-bold">

                            Container Terminal MIS

                        </h5>


                        <p class="footer-text">

                            Management Information System supporting
                            container terminal operations, operational
                            data management, reporting and performance
                            monitoring.

                        </p>

                    </div>

                </div>


                <!-- OPERATIONS -->

                <div class="col-lg-2 col-md-6">

                    <h5 class="footer-heading mb-4">

                        Operations

                    </h5>


                    <ul class="footer-links list-unstyled">


                        <li class="mb-2">

                            <a asp-controller="Cargo"
                               asp-action="CargoView">

                                <i class="bi bi-chevron-right me-2"></i>

                                Containers

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Cargo"
                               asp-action="MovedContainers">

                                <i class="bi bi-chevron-right me-2"></i>

                                Movements

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="TruckTurnaround"
                               asp-action="Index">

                                <i class="bi bi-chevron-right me-2"></i>

                                Trucks

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="VesselOperation"
                               asp-action="Index">

                                <i class="bi bi-chevron-right me-2"></i>

                                Vessels

                            </a>

                        </li>


                    </ul>

                </div>


                <!-- REPORTING -->

                <div class="col-lg-3 col-md-6">

                    <h5 class="footer-heading mb-4">

                        Reporting

                    </h5>


                    <ul class="footer-links list-unstyled">


                        <li class="mb-2">

                            <a asp-controller="Operations"
                               asp-action="OperationsReport">

                                <i class="bi bi-chevron-right me-2"></i>

                                Operations Report

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Reports"
                               asp-action="Index">

                                <i class="bi bi-chevron-right me-2"></i>

                                MIS Reports

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#">

                                <i class="bi bi-chevron-right me-2"></i>

                                KPI Dashboard

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#">

                                <i class="bi bi-chevron-right me-2"></i>

                                Data Analytics

                            </a>

                        </li>


                    </ul>

                </div>


                <!-- SYSTEM -->

                <div class="col-lg-3 col-md-6">

                    <h5 class="footer-heading mb-4">

                        System

                    </h5>


                    <ul class="footer-contact list-unstyled">


                        <li class="mb-3">

                            <i class="bi bi-building me-3"></i>

                            <span>

                                Terminal Operations MIS

                            </span>

                        </li>


                        <li class="mb-3">

                            <i class="bi bi-database-check me-3"></i>

                            <span>

                                Database Connected

                            </span>

                        </li>


                        <li class="mb-3">

                            <i class="bi bi-shield-check me-3"></i>

                            <span>

                                Secure Operational Environment

                            </span>

                        </li>


                        <li class="mb-3">

                            <i class="bi bi-clock me-3"></i>

                            <span>

                                24-Hour Operations

                            </span>

                        </li>


                    </ul>

                </div>


            </div>


            <!-- FOOTER BOTTOM -->

            <div class="footer-bottom">


                <div class="row align-items-center">


                    <div class="col-md-6">

                        <p class="mb-0 text-white-50">

                            &copy; @DateTime.Now.Year -
                            Container Terminal Management Information System

                        </p>

                    </div>


                    <div class="col-md-6 text-md-end mt-3 mt-md-0">

                        <span class="text-white-50 small">

                            <i class="bi bi-shield-lock me-1"></i>

                            Authorised Operational System

                        </span>

                    </div>


                </div>


            </div>


        </div>

    </footer>


    <!-- ============================================================
         JAVASCRIPT
         ============================================================ -->


    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- ============================================================
         OWL CAROUSEL
         ============================================================ -->

    <script>

        $(document).ready(function () {

            $('.owl-carousel').owlCarousel({

                loop: true,

                margin: 30,

                nav: true,

                dots: true,

                autoplay: true,

                autoplayTimeout: 5000,

                autoplayHoverPause: true,

                responsive: {

                    0: {
                        items: 1
                    },

                    768: {
                        items: 2
                    },

                    992: {
                        items: 3
                    }

                }

            });


            // ======================================================
            // NAVBAR SCROLL
            // ======================================================

            $(window).scroll(function () {

                if ($(window).scrollTop() > 40) {

                    $('.navbar').addClass('navbar-scrolled');

                }
                else {

                    $('.navbar').removeClass('navbar-scrolled');

                }

            });


        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
