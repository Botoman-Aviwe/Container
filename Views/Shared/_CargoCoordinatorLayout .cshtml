                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="PerformanceReport"
                           class="@(IsCurrent("CargoCoordinator", "PerformanceReport") ? "active" : "")">
                            <i class="bx bx-trending-up icon"></i>
                            <span>Performance Report</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="DailyOperationsReport"
                           class="@(IsCurrent("CargoCoordinator", "DailyOperationsReport") ? "active" : "")">
                            <i class="bx bx-calendar icon"></i>
                            <span>Daily Operations</span>
                        </a>
                    </li>
                </ul>
