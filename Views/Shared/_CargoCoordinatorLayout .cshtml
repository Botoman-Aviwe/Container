                           class="@(IsCurrent("CargoCoordinator", "Manifest") ? "active" : "")">
                            <i class="bx bx-spreadsheet icon"></i>
                            <span>Cargo Manifest</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="CustomsDocs"
                           class="@(IsCurrent("CargoCoordinator", "CustomsDocs") ? "active" : "")">
                            <i class="bx bx-id-card icon"></i>
                            <span>Customs Documents</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="BillOfLading"
                           class="@(IsCurrent("CargoCoordinator", "BillOfLading") ? "active" : "")">
