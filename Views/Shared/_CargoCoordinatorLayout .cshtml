                            <span>Cargo Coordinator</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="IndexShipments"
                           class="@(IsCurrent("CargoCoordinator", "IndexShipments") ? "active" : "")">
                            <i class="bx bx-list-ul icon"></i>
                            <span>View All Shipments</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="ShipmentTracking"
                           class="@(IsCurrent("CargoCoordinator", "ShipmentTracking") ? "active" : "")">
                            <i class="bx bx-map icon"></i>
                            <span>Track Shipments</span>
