@using Microsoft.AspNetCore.Identity
@using PrescribingSystem.Data
@inject UserManager<ApplicationUser> UserManager
@{
    ApplicationUser appUser = null;
    string fullName = "Guest";
    string roleName = "";
    string initials = "";

    if (User.Identity.IsAuthenticated)
    {
        appUser = await UserManager.GetUserAsync(User);

        if (appUser != null)
        {
            fullName = $"{appUser.FirstName} {appUser.LastName}";
            var roles = await UserManager.GetRolesAsync(appUser);
            roleName = roles.FirstOrDefault() ?? "No Role";

            initials = $"{appUser.FirstName?[0]}{appUser.LastName?[0]}".ToUpper();
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Cargo Management System</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Boxicons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom Layout CSS -->
    <link rel="stylesheet" href="~/css/sidebar.css" />

    <style>
        /* Same submenu styles as original */
        .nav-link.has-submenu {
            position: relative;
        }

            .nav-link.has-submenu > a {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .submenu-toggle {
            transition: transform 0.3s ease;
            margin-left: auto;
        }

        .nav-link.has-submenu.active .submenu-toggle {
            transform: rotate(180deg);
        }

        .submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            padding-left: 1.5rem;
        }

        .nav-link.has-submenu.active .submenu {
            max-height: 500px;
        }

        .submenu li {
            margin: 0.25rem 0;
        }

        .submenu a {
            display: flex;
            align-items: center;
            padding: 0.5rem 1rem;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            border-radius: 0.375rem;
            transition: all 0.3s ease;
        }

            .submenu a:hover,
            .submenu a.active {
                background: rgba(255, 255, 255, 0.1);
                color: white;
            }

        .submenu .icon {
            font-size: 1.1rem;
            margin-right: 0.75rem;
        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <img src="~/css/Transnet_logo.svg.webp" alt="Logo" class="logo" />
            <div class="brand-text">
                <div>Cargo Management</div>
                <div class="brand-subtext">Information System</div>
            </div>
        </div>

        <ul class="menu-links">
            <!-- Dashboard -->
            <li class="nav-link">
                <a asp-controller="Home" asp-action="Index" class="active">
                    <i class='bx bx-home icon'></i>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>

            <!-- Shipments Section with Collapse -->
            <li class="nav-link has-submenu">
                <a href="#" class="submenu-parent">
                    <div class="submenu-content">
                        <i class='bx bx-ship icon'></i>
                        <span class="nav-text">Shipments</span>
                    </div>
                    <i class='bx bx-chevron-down submenu-toggle'></i>
                </a>
                <ul class="submenu">
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="CargoView">
                            <i class='bx bx-plus-circle icon'></i>
                            <span>Cargo Coordinator</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="IndexShipments">
                            <i class='bx bx-list-ul icon'></i>
                            <span>View All Shipments</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="ShipmentTracking">
                            <i class='bx bx-map icon'></i>
                            <span>Track Shipments</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Containers Section -->
            <li class="nav-link has-submenu">
                <a href="#" class="submenu-parent">
                    <div class="submenu-content">
                        <i class='bx bx-cube icon'></i>
                        <span class="nav-text">Containers</span>
                    </div>
                    <i class='bx bx-chevron-down submenu-toggle'></i>
                </a>
                <ul class="submenu">
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="ManageContainers">
                            <i class='bx bx-package icon'></i>
                            <span>Manage Containers</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="ContainerTracking">
                            <i class='bx bx-radar icon'></i>
                            <span>Container Tracking</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="ContainerAllocation">
                            <i class='bx bx-check-circle icon'></i>
                            <span>Allocation Status</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Vessel Operations Section -->
            <li class="nav-link has-submenu">
                <a href="#" class="submenu-parent">
                    <div class="submenu-content">
                        <i class='bx bx-anchor icon'></i>
                        <span class="nav-text">Vessel Operations</span>
                    </div>
                    <i class='bx bx-chevron-down submenu-toggle'></i>
                </a>
                <ul class="submenu">
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="VesselSchedule">
                            <i class='bx bx-calendar-event icon'></i>
                            <span>Vessel Schedule</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="PortCalls">
                            <i class='bx bx-building icon'></i>
                            <span>Port Calls</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="BerthAllocation">
                            <i class='bx bx-dock icon'></i>
                            <span>Berth Allocation</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Documentation Section -->
            <li class="nav-link has-submenu">
                <a href="#" class="submenu-parent">
                    <div class="submenu-content">
                        <i class='bx bx-file icon'></i>
                        <span class="nav-text">Documentation</span>
                    </div>
                    <i class='bx bx-chevron-down submenu-toggle'></i>
                </a>
                <ul class="submenu">
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="Manifest">
                            <i class='bx bx-spreadsheet icon'></i>
                            <span>Cargo Manifest</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="CustomsDocs">
                            <i class='bx bx-id-card icon'></i>
                            <span>Customs Documents</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="BillOfLading">
                            <i class='bx bx-receipt icon'></i>
                            <span>Bill of Lading</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Reports Section -->
            <li class="nav-link has-submenu">
                <a href="#" class="submenu-parent">
                    <div class="submenu-content">
                        <i class='bx bx-bar-chart-alt-2 icon'></i>
                        <span class="nav-text">Reports</span>
                    </div>
                    <i class='bx bx-chevron-down submenu-toggle'></i>
                </a>
                <ul class="submenu">
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="CargoSummary">
                            <i class='bx bx-pie-chart-alt icon'></i>
                            <span>Cargo Summary</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="PerformanceReport">
                            <i class='bx bx-trending-up icon'></i>
                            <span>Performance Report</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator" asp-action="DailyOperationsReport">
                            <i class='bx bx-calendar icon'></i>
                            <span>Daily Operations</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Settings -->
            <li class="nav-link">
                <a asp-controller="CargoCoordinator" asp-action="Settings">
                    <i class='bx bx-cog icon'></i>
                    <span class="nav-text">Settings</span>
                </a>
            </li>

            <!-- Help & Support -->
            <li class="nav-link">
                <a href="#">
                    <i class='bx bx-help-circle icon'></i>
                    <span class="nav-text">Help & Support</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content Area -->
    <div class="main-content">
        <div class="header-bar">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class='bx bx-menu'></i>
            </button>
            <div class="page-title">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="user-menu">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="user-name">@fullName</div>
                    <div class="user-role">@roleName</div>
                    <div class="user-avatar">@initials</div>
                }
            </div>
        </div>

        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar toggle functionality
        document.getElementById('sidebarToggle').addEventListener('click', function() {
            document.querySelector('.sidebar').classList.toggle('active');
        });

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function(event) {
            const sidebar = document.querySelector('.sidebar');
            const toggleBtn = document.getElementById('sidebarToggle');
            if (window.innerWidth <= 992 &&
                !sidebar.contains(event.target) &&
                !toggleBtn.contains(event.target) &&
                sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
            }
        });

        // Collapsible submenu functionality
        document.addEventListener('DOMContentLoaded', function() {
            const submenuParents = document.querySelectorAll('.submenu-parent');

            submenuParents.forEach(parent => {
                parent.addEventListener('click', function(e) {
                    e.preventDefault();
                    const navLink = this.parentElement;
                    navLink.classList.toggle('active');
                });
            });

            // Set active state based on current page
            const currentLocation = window.location.href;
            const menuLinks = document.querySelectorAll('.nav-link a, .submenu a');
            menuLinks.forEach(link => {
                if (link.href === currentLocation) {
                    link.classList.add('active');

                    // If it's a submenu item, open the parent submenu
                    const submenuItem = link.closest('.submenu');
                    if (submenuItem) {
                        const parentNavLink = submenuItem.closest('.has-submenu');
                        if (parentNavLink) {
                            parentNavLink.classList.add('active');
                        }
                    }
                }
            });
        });

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 992) {
                document.querySelector('.sidebar').classList.remove('active');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>