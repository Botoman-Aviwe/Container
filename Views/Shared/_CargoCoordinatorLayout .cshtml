@using Microsoft.AspNetCore.Identity
@using PrescribingSystem.Data
@using System
@using System.Linq
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser appUser = null;
    string fullName = "Guest";
    string roleName = "Guest";
    string initials = "GU";

    if (User.Identity?.IsAuthenticated == true)
    {
        appUser = await UserManager.GetUserAsync(User);

        if (appUser != null)
        {
            fullName = $"{appUser.FirstName} {appUser.LastName}".Trim();

            var roles = await UserManager.GetRolesAsync(appUser);
            roleName = roles.FirstOrDefault() ?? "No Role";

            var firstInitial = !string.IsNullOrWhiteSpace(appUser.FirstName)
                ? appUser.FirstName.Substring(0, 1)
                : "";

            var lastInitial = !string.IsNullOrWhiteSpace(appUser.LastName)
                ? appUser.LastName.Substring(0, 1)
                : "";

            initials = (firstInitial + lastInitial).ToUpperInvariant();

            if (string.IsNullOrWhiteSpace(initials))
            {
                initials = "GU";
            }
        }
    }

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsCurrent(string controller, string action = "")
    {
        return currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
            && (string.IsNullOrEmpty(action)
                || currentAction.Equals(action, StringComparison.OrdinalIgnoreCase));
    }

    bool IsInController(string controller)
    {
        return currentController.Equals(controller, StringComparison.OrdinalIgnoreCase);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Transnet Container Operations MIS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Boxicons: sidebar icons -->
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons: dashboard icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Your existing sidebar stylesheet -->
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />

    <style>
        :root {
            --transnet-blue: #003b71;
            --transnet-dark: #00264d;
            --transnet-yellow: #f5c400;
            --sidebar-width: 265px;
            --header-height: 76px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f4f7fb;
            color: #1e293b;
        }

        a {
            text-decoration: none;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            width: var(--sidebar-width);
            height: 100vh;
            overflow-y: auto;
            background: linear-gradient(180deg, var(--transnet-dark), #003b71);
            color: white;
            z-index: 1050;
            transition: transform .3s ease;
            box-shadow: 4px 0 20px rgba(0, 25, 55, .12);
        }

        .sidebar-header {
            min-height: 90px;
            padding: 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255,255,255,.12);
        }

            .sidebar-header .logo {
                width: 45px;
                height: 45px;
                object-fit: contain;
                background: white;
                border-radius: 10px;
                padding: 4px;
                flex-shrink: 0;
            }

        .brand-text {
            font-size: 15px;
            font-weight: 800;
            line-height: 1.4;
        }

        .brand-subtext {
            color: rgba(255,255,255,.68);
            font-size: 11px;
            font-weight: 400;
            margin-top: 3px;
        }

        .menu-links {
            padding: 16px 12px 28px;
            margin: 0;
            list-style: none;
        }

        .nav-link {
            padding: 0;
            margin-bottom: 5px;
            position: relative;
        }

            .nav-link > a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 13px;
                min-height: 45px;
                color: rgba(255,255,255,.82);
                border-radius: 9px;
                font-size: 13px;
                font-weight: 500;
                transition: background .2s ease, color .2s ease;
            }

                .nav-link > a:hover,
                .nav-link > a.active {
                    color: #fff;
                    background: rgba(255,255,255,.12);
                }

                .nav-link > a.active {
                    box-shadow: inset 3px 0 var(--transnet-yellow);
                }

            .nav-link .icon {
                font-size: 21px;
                flex-shrink: 0;
            }

        .submenu-content {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-link.has-submenu > .submenu-parent {
            justify-content: space-between;
        }

        .submenu-toggle {
            font-size: 18px;
            transition: transform .25s ease;
        }

        .nav-link.has-submenu.active > .submenu-parent .submenu-toggle {
            transform: rotate(180deg);
        }

        .submenu {
            list-style: none;
            max-height: 0;
            overflow: hidden;
            padding: 0 0 0 13px;
            margin: 0;
            transition: max-height .3s ease;
        }

        .nav-link.has-submenu.active > .submenu {
            max-height: 650px;
        }

        .submenu li {
            margin: 3px 0;
        }

        .submenu a {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 11px;
            border-radius: 8px;
            color: rgba(255,255,255,.72);
            font-size: 12px;
            transition: background .2s ease, color .2s ease;
        }

            .submenu a:hover,
            .submenu a.active {
                background: rgba(255,255,255,.11);
                color: white;
            }

        .submenu .icon {
            font-size: 18px;
        }

        /* Main area */
        .main-content {
            min-height: 100vh;
            margin-left: var(--sidebar-width);
            transition: margin-left .3s ease;
        }

        .header-bar {
            height: var(--header-height);
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 0 28px;
            background: rgba(255,255,255,.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid #e8edf4;
        }

        .sidebar-toggle {
            width: 40px;
            height: 40px;
            border: 1px solid #e3e9f1;
            border-radius: 10px;
            background: white;
            color: var(--transnet-blue);
            font-size: 23px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }

            .sidebar-toggle:hover {
                background: #edf5fd;
            }

        .page-title {
            flex: 1;
            min-width: 0;
        }

            .page-title h1 {
                margin: 0;
                font-size: 18px;
                font-weight: 800;
                color: var(--transnet-dark);
                overflow-wrap: anywhere;
            }

        .user-menu {
            display: grid;
            grid-template-columns: minmax(0, auto) 42px;
            grid-template-rows: auto auto;
            column-gap: 12px;
            align-items: center;
        }

        .user-name {
            grid-column: 1;
            grid-row: 1;
            text-align: right;
            font-size: 12px;
            font-weight: 700;
            color: #1e293b;
        }

        .user-role {
            grid-column: 1;
            grid-row: 2;
            text-align: right;
            font-size: 11px;
            color: #64748b;
            margin-top: 3px;
        }

        .user-avatar {
            grid-column: 2;
            grid-row: 1 / span 2;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--transnet-blue);
            color: white;
            font-weight: 800;
            font-size: 13px;
            border: 2px solid #d8e8f7;
        }

        .content-wrapper {
            padding: 26px 28px 36px;
            min-width: 0;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.active {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .header-bar {
                padding: 0 18px;
            }

            .content-wrapper {
                padding: 20px 18px 30px;
            }
        }

        @@media (max-width: 576px) {
            :root {
                --header-height: 66px;
            }

            .header-bar {
                gap: 10px;
                padding: 0 12px;
            }

            .page-title h1 {
                font-size: 14px;
            }

            .user-menu {
                grid-template-columns: 36px;
            }

            .user-name,
            .user-role {
                display: none;
            }

            .user-avatar {
                grid-column: 1;
                grid-row: 1;
                width: 36px;
                height: 36px;
            }

            .content-wrapper {
                padding: 16px 12px 25px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Sidebar -->
    <nav class="sidebar" id="appSidebar" aria-label="Main navigation">

        <div class="sidebar-header">
            <img src="~/css/Transnet_logo.svg.webp"
                 alt="Transnet Logo"
                 class="logo" />

            <div class="brand-text">
                <div>Transnet Operations</div>
                <div class="brand-subtext">Container Operations MIS</div>
            </div>
        </div>

        <ul class="menu-links">

            <!-- Dashboard -->
            <li class="nav-link">
                <a asp-controller="CargoCoordinator"
                   asp-action="Index"
                   class="@(IsCurrent("CargoCoordinator", "Index") ? "active" : "")">
                    <i class="bx bx-home icon"></i>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>

            <!-- Shipments -->
            <li class="nav-link has-submenu @(IsInController("CargoCoordinator") && (IsCurrent("CargoCoordinator", "CargoView") || IsCurrent("CargoCoordinator", "IndexShipments") || IsCurrent("CargoCoordinator", "ShipmentTracking")) ? "active" : "")">

                <a href="#" class="submenu-parent" aria-expanded="@(IsCurrent("CargoCoordinator", "CargoView") || IsCurrent("CargoCoordinator", "IndexShipments") || IsCurrent("CargoCoordinator", "ShipmentTracking") ? "true" : "false")">
