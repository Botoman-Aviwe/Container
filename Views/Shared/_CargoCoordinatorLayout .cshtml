                    </li>
                </ul>
            </li>

            <!-- Containers -->
            <li class="nav-link has-submenu @(IsCurrent("CargoCoordinator", "ManageContainers") || IsCurrent("CargoCoordinator", "ContainerTracking") || IsCurrent("CargoCoordinator", "ContainerAllocation") ? "active" : "")">

                <a href="#" class="submenu-parent" aria-expanded="@(IsCurrent("CargoCoordinator", "ManageContainers") || IsCurrent("CargoCoordinator", "ContainerTracking") || IsCurrent("CargoCoordinator", "ContainerAllocation") ? "true" : "false")">
                    <span class="submenu-content">
                        <i class="bx bx-cube icon"></i>
                        <span class="nav-text">Containers</span>
                    </span>
                    <i class="bx bx-chevron-down submenu-toggle"></i>
                </a>

                <ul class="submenu">
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="ManageContainers"
                           class="@(IsCurrent("CargoCoordinator", "ManageContainers") ? "active" : "")">
                            <i class="bx bx-package icon"></i>
                            <span>Manage Containers</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="ContainerTracking"
                           class="@(IsCurrent("CargoCoordinator", "ContainerTracking") ? "active" : "")">
                            <i class="bx bx-radar icon"></i>
                            <span>Container Tracking</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="ContainerAllocation"
                           class="@(IsCurrent("CargoCoordinator", "ContainerAllocation") ? "active" : "")">
                            <i class="bx bx-check-circle icon"></i>
                            <span>Allocation Status</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Vessel Operations -->
            <li class="nav-link has-submenu @(IsCurrent("CargoCoordinator", "VesselSchedule") || IsCurrent("CargoCoordinator", "PortCalls") || IsCurrent("CargoCoordinator", "BerthAllocation") ? "active" : "")">

                <a href="#" class="submenu-parent" aria-expanded="@(IsCurrent("CargoCoordinator", "VesselSchedule") || IsCurrent("CargoCoordinator", "PortCalls") || IsCurrent("CargoCoordinator", "BerthAllocation") ? "true" : "false")">
                    <span class="submenu-content">
                        <i class="bx bx-anchor icon"></i>
                        <span class="nav-text">Vessel Operations</span>
                    </span>
                    <i class="bx bx-chevron-down submenu-toggle"></i>
                </a>

                <ul class="submenu">
                    <li>
                        <a asp-controller="CargoCoordinator"
                           asp-action="VesselSchedule"
