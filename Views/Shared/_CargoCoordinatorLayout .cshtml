                    <span class="submenu-content">
                        <i class="bx bx-file icon"></i>
                        <span class="nav-text">Documentation</span>
                    </span>
                    <i class="bx bx-chevron-down submenu-toggle"></i>
                </a>

                <ul class="submenu">
